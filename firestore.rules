rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.toLowerCase() == 'akashbehera599@gmail.com' ||
        request.auth.token.email.toLowerCase() == 'akstarofficial732@gmail.com'
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Store Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // APK Catalog
    match /apks/{apkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pricing Plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']));
    }

    // Orders
    match /orders/{orderId} {
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Purchases / Entitlements
    match /purchases/{purchaseId} {
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
